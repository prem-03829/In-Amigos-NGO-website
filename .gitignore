# Ignore everything by default
*

# Keep directories
!*/

# Allow essential project files
!.gitignore
!vercel.json
!README.md
!package.json
!postcss.config.js
!tailwind.config.js
!vite.config.js
!index.html
!eslint.config.js

# Allow .github folder for CI/CD
!.github/
!.github/**

# Allow frontend source and public files
!frontend/
!frontend/**
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

# Allow backend folder structure
!backend/
!backend/**

# --- Specific Exclusions (Even if allowed above) ---

# Ignore dependencies and environments
**/node_modules/
**/.venv/
**/venv/
**/env/
**/ENV/

# Ignore build artifacts
**/dist/
**/.vite/
**/build/

# Ignore secrets and local environments
**/.env*
**/local_settings.py

# Ignore system files
.DS_Store
Thumbs.db
